{
  "name": "reader",
  "version": "2026.11.17.1",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "lint": "eslint .",
    "assets:download": "bash ./download-external-assets.sh",
    "assets:download:magika": "bash ./scripts/download-magika-model.sh",
    "build": "node ./integrity-check.cjs && tsc -p .",
    "build:watch": "tsc --watch",
    "build:clean": "rm -rf ./build",
    "serve": "npm run build && npm run start",
    "debug": "npm run build && npm run dev",
    "start": "node ./build/stand-alone/crawl.js",
    "dry-run": "NODE_ENV=dry-run node ./build/stand-alone/search.js",
    "test:unit": "tsc -p tests/tsconfig.json && node tests-build/run-unit.js",
    "test:ocr": "python3 -m unittest discover -s deploy/ocr -p 'test_*.py'",
    "test:e2e": "tsc -p tests/tsconfig.json && node tests-build/run.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit:coverage": "tsc -p tests/tsconfig.json && c8 node tests-build/run-unit.js",
    "test:e2e:coverage": "tsc -p tests/tsconfig.json && c8 node tests-build/run.js",
    "test:coverage": "tsc -p tests/tsconfig.json && c8 --reporter=none node tests-build/run-unit.js && c8 --no-clean --reporter=none node tests-build/run.js && c8 report",
    "logs:analyze": "bash ./scripts/analyze-logs.sh"
  },
  "engines": {
    "node": ">=22.15"
  },
  "main": "build/index.js",
  "types": "./build/stand-alone/crawl.d.ts",
  "exports": {
    ".": "./build/stand-alone/crawl.js",
    "./crawl": "./build/stand-alone/crawl.js",
    "./search": "./build/stand-alone/search.js",
    "./serp": "./build/stand-alone/serp.js"
  },
  "dependencies": {
    "@esm2cjs/normalize-url": "^8.0.0",
    "@firecrawl/anydoc": "^0.2.4",
    "@koa/bodyparser": "^6.1.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.1.1",
    "@nomagick/mathml-to-latex": "^1.5.3",
    "@nomagick/node-libcurl-impersonate": "^5.2.3",
    "@xmldom/xmldom": "^0.9.12",
    "civkit": "^0.10.5-2ed856a",
    "dayjs": "^1.11.23",
    "franc": "^6.2.0",
    "generic-pool": "^3.9.0",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.17",
    "koa": "^3.3.0",
    "linkedom": "^0.18.15",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "magika": "^1.0.0",
    "mathml-to-latex": "^1.8.0",
    "maxmind": "^5.1.0",
    "minio": "^8.0.7",
    "pdfjs-dist": "^6.5.438",
    "puppeteer": "^25.17.0",
    "robots-parser": "^3.0.1",
    "set-cookie-parser": "^3.2.3",
    "stripe": "^23.1.0",
    "svg2png-wasm": "^1.4.1",
    "tiktoken": "^1.0.22",
    "tld-extract": "^2.1.0",
    "tslib": "^2.9.1",
    "tsyringe": "^4.10.0",
    "undici": "^8.12.4",
    "xpath": "^0.0.36"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "openai": "^7.57.0",
    "pino-pretty": "^13.2.0",
    "replicate": "^1.4.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3"
  },
  "private": true,
  "overrides": {
    "adm-zip": "^0.6.1",
    "tar": "7.5.23",
    "express": "^4.22.3",
    "qs": "^6.17.1",
    "body-parser": "^1.20.9",
    "proxy-addr": "^2.0.8",
    "basic-ftp": "^6.2.6",
    "nodemailer": "^10.6.0",
    "decode-uri-component": "^0.5.1"
  }
}
